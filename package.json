{
  "name": "poe2-build-trade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Search items from PoE2 build guides on the official trade site.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
