    "e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
